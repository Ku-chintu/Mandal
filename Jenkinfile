pipeline {
    agent any

    environment {
        BUILD_DIR = 'dist'
        DEPLOY_DIR = '/var/www/mandal'
        NGINX_CONF = '/etc/nginx/sites-available/mandal'
        NGINX_LINK = '/etc/nginx/sites-enabled/mandal'
    }

    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/Ku-chintu/Mandal.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Check Vite Installation') {
            steps {
                sh '''
                    if [ -f node_modules/.bin/vite ]; then
                      echo "Vite is installed locally."
                    else
                      echo "Vite is not installed."
                      exit 1
                    fi
                '''
            }
        }

        stage('Build Project') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Configure Nginx') {
            steps {
                sh '''
                    # Ensure deploy dir and nginx config dirs exist
                    sudo mkdir -p $DEPLOY_DIR
                    sudo mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

                    # Copy build files
                    sudo cp -r $BUILD_DIR/* $DEPLOY_DIR/

                    # Write nginx config with proper escaping
                    echo "server {
                        listen 80;
                        server_name _;
                        root $DEPLOY_DIR;
                        index index.html;

                        location / {
                            try_files \\$uri \\$uri/ /index.html;
                        }
                    }" | sudo tee $NGINX_CONF

                    # Link and reload nginx
                    sudo ln -sf $NGINX_CONF $NGINX_LINK
                    sudo nginx -t && sudo systemctl reload nginx
                '''
            }
        }
    }

    post {
        failure {
            echo "❌ Pipeline failed."
        }
        success {
            echo "✅ Deployment successful!"
        }
    }
}
